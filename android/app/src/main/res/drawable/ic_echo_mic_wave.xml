<?xml version="1.0" encoding="utf-8"?>
<!--
    Floating-assistant glyph: line-art microphone with heartbeat waveform.
    Paths scaled up so the mic capsule fills ~70% of the 48×48 viewport,
    making it clearly visible at the pill's rendered size (≈21dp content area).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- Waveform — left segment -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M1,22 L5,22 L7,14 L9,30 L11.5,18 L13.5,22 L15,22" />

    <!-- Waveform — right segment -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M33,22 L34.5,22 L36.5,15 L38.5,29 L41,12 L43,22 L47,22" />

    <!-- Microphone capsule (larger — spans x=15–33, y=5–27) -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M15,14 A9,9 0 0 1 33,14 L33,24 A9,9 0 0 1 15,24 Z" />

    <!-- Grille lines inside capsule -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M20,8.5 L28,8.5 M20,11.5 L28,11.5 M20,14.5 L28,14.5" />

    <!-- Capsule divider -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M15.5,22 L32.5,22" />

    <!-- Stand: stem + base bar -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M24,33 L24,41 M18,41.5 L30,41.5" />

</vector>
