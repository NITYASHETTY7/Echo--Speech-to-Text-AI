<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Window-level XML theme — used only for system window chrome (status bar,
        nav bar) before Compose takes over the surface.

        All Material 3 / Echo design theming is done inside EchoTheme (Theme.kt).
        This file MUST NOT impose any Light or Dark visual style on Compose content.

        Parent: Theme.AppCompat.DayNight.NoActionBar
        - Neutral: follows the system day/night configuration automatically.
        - Does NOT force Light or Dark on the window background.
        - Compose's EchoTheme (isSystemInDarkTheme()) takes full control of colors.
    -->
    <style name="Theme.Echo" parent="android:Theme.DeviceDefault.NoActionBar">
        <!--
            Use a transparent window background so Compose's Surface fills
            the window without a color flash on launch.
            Both light and dark mode will see the Compose background immediately.
        -->
        <item name="android:windowBackground">@color/window_background</item>

        <!--
            Status bar: transparent so Compose can draw edge-to-edge.
            Icon color (light/dark) is controlled per-variant below.
        -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!--
            Light mode: dark icons on light status/nav bar.
            Overridden to false in values-night/themes.xml for dark mode.
        -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!--
        Transparent, translucent variant used by SnoozeActivity — a trampoline
        Activity that hosts only a ModalBottomSheet. Keeps the underlying app
        visible behind the sheet's own scrim, like a system dialog.
    -->
    <style name="Theme.Echo.Transparent" parent="Theme.Echo">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
