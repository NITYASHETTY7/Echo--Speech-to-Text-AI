<?xml version="1.0" encoding="utf-8"?>
<!--
    All traffic goes to https://api.groq.com over TLS.
    No cleartext HTTP is permitted; the LAN domain exception is removed.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
